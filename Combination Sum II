class Solution:
    def sum(self,num,current,ans,index,k):
        if index==len(num):
            if k==0:
                ans.append(current.copy())
            return
        if num[index]<=k:
            current.append(num[index])
            self.sum(num,current,ans,index+1,k-num[index])
            current.pop()
        self.sum(num,current,ans,index+1,k)
obj=Solution()
num=[10,1,2,7,6,1,5]
k=int(input("Enter the number"))
current=[]
ans=[]
index=0
for i in range(len(num)):
    for j in range(i+1,len(num)):
        if num[i]>num[j]:
            num[i],num[j]=num[j],num[i]
obj.sum(num,current,ans,index,k)
print(ans)
