class Solution:
    def binary(self,num):
        l=[]
        q=num
        while(q!=0):
            r=q%2
            l.append(r)
            q=int(q/2)
        n=len(l)
        s=""
        for i in range(n-1,-1,-1):
            s=s+str(l[i])
        m=[]
        for i in s:
            if i=='1':
                m.append(i)
        b=len(m)
        return b
obj=Solution()
num=int(input("Enter the number"))
print(obj.binary(num))
