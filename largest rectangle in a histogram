class Solution:
  def __init__(self):
    self.s=[]
    self.t=-1
  def isEmpty(self):
    return self.t==-1
  def pop(self):
    x=self.s[self.t]
    self.s.pop()
    self.t-=1
    return x
  def result(self,a):
    area=0
    h=0
    w=0
    a.append(0)
    for i in range(len(a)):
      while (not self.isEmpty()) and a[self.s[self.t]]>a[i]:
        h=a[self.pop()]
        if not self.isEmpty():
          w=i-self.s[self.t]-1
        else:
          w=i
        area=max(area,h*w)
      self.s.append(i)
      self.t+=1
    h=a[self.pop()]
    return area
obj=Solution()
a=[2, 1, 5, 6, 2, 3]
print(obj.result(a))
