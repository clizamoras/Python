class Solution:
    def numbers(self,num,count,k,current,index):
        if len(num)==index:
            if current==k:
                return count+1
            return 0
        taken= self.numbers(num,count,k,current+num[index],index+1)
        skip= self.numbers(num,count,k,current,index+1)
        return taken+skip

obj=Solution()
num=[4, 9, 2, 5, 1]
count=0
k=int(input("Enter the number"))
current=0
index=0
print(obj.numbers(num,count,k,current,index))
