class Node:
  def __init__(self,data):
    self.data=data
    self.left=None
    self.right=None
root=Node(1)
root.left=Node(2)
root.right=Node(3)
root.left.left=Node(4)
root.left.right=Node(5)
root.right.left=Node(6)
root.right.right=Node(7)
class Solution:
  def height(self,root):
    if root==None:
      return 0
    return 1+max(self.height(root.left),self.height(root.right))
  def diameter(self,root):
   if root==None:
     return 0
   p=root
   left=self.height(p.left)
   right=self.height(p.right)
   b=left+right
   l=self.diameter(p.left)
   r=self.diameter(p.right)
   return max(b,l,r)
obj=Solution()
print(obj.diameter(root))
