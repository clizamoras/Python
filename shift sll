class Node:
    def __init__(self,data):
        self.data=data
        self.next=None
    
class Solution:
    def reverse(self,head,k):
        current=head
        count=0
        while current:
            current=current.next
            count=count+1
        l=count-k
        current=head
        c=0
        while current and c<l-1:
            current=current.next
            c=c+1
        new_head=current.next
        last=new_head
        while last.next!=None:
            last=last.next
        last.next=head
        current.next=None
        return new_head
            
       
    def printlist(self,head):
        while head:
            print(head.data,end=" ")
            head=head.next
obj=Solution()
head=Node(1)
first=Node(2)
second=Node(3)
third=Node(4)
fourth=Node(5)
head.next=first
first.next=second
second.next=third
third.next=fourth
k=int(input("Enter the value"))
head=obj.reverse(head,k)
obj.printlist(head)
