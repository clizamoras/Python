        <tr>
            <th>Day</th>
            <th>9:00 - 10:00</th>
            <th>10:00 - 11:00</th>
            <th>11:00 - 12:00</th>
            <th>12:00 - 1:00</th>
            <th>1:00 - 2:00</th>
            <th>2:00 - 3:00</th>
        </tr>

        <tr>
            <th>Monday</th>
            <td>DBMS<br>(Mr. Kumar)</td>
            <td>Java<br>(Ms. Priya)</td>
            <td>Python<br>(Mr. Raj)</td>
            <td rowspan="5" class="break">LUNCH BREAK</td>
            <td colspan="2" class="lab">
                DBMS Lab<br>(Mr. Kumar)
            </td>
        </tr>

        <tr>
            <th>Tuesday</th>
            <td>Python<br>(Mr. Raj)</td>
            <td>DBMS<br>(Mr. Kumar)</td>
            <td>Java<br>(Ms. Priya)</td>
            <td>Maths<br>(Mr. Ravi)</td>
            <td>English<br>(Ms. Anu)</td>
        </tr>

        <tr>
            <th>Wednesday</th>
            <td>Java<br>(Ms. Priya)</td>
            <td>Maths<br>(Mr. Ravi)</td>
            <td>English<br>(Ms. Anu)</td>
            <td colspan="2" class="lab">
                Python Lab<br>(Mr. Raj)
            </td>
        </tr>

        <tr>
            <th>Thursday</th>
            <td>DBMS<br>(Mr. Kumar)</td>
            <td>English<br>(Ms. Anu)</td>
            <td>Maths<br>(Mr. Ravi)</td>
            <td>Python<br>(Mr. Raj)</td>
            <td>Java<br>(Ms. Priya)</td>
        </tr>

        <tr>
            <th>Friday</th>
            <td>Maths<br>(Mr. Ravi)</td>
            <td>Java<br>(Ms. Priya)</td>
            <td>DBMS<br>(Mr. Kumar)</td>
            <td colspan="2" class="lab">
                Java Lab<br>(Ms. Priya)
            </td>
        </tr>

    </table>

</body>
</html>
