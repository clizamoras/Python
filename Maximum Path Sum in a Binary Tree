class Node:
  def __init__(self,data):
    self.data=data
    self.right=None
    self.left=None
root=Node(1)
root.left=Node(2)
root.right=Node(3)
root.left.left=Node(4)
root.left.right=Node(5)
root.right.left=Node(6)
root.right.right=Node(7)
class Solution:
  def sum(self,root):
    self.maxsum=float('-inf')
    def findsum(root):
      if root==None:
        return 0
      left=findsum(root.left)
      right=findsum(root.right)
      left=max(0,left)
      right=max(0,right)
      r=root.data+left+right
      if r>self.maxsum:
        self.maxsum=r
      return root.data+max(left,right)
    findsum(root)
    return self.maxsum
obj=Solution()
print(obj.sum(root))
