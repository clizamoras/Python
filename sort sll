class Node:
    def __init__(self,data):
        self.data=data
        self.next=None
class Solution:
    def sort(self,head):
        current=head
        arr=[]
        while current:
            arr.append(current.data)
            current=current.next
        n=len(arr)
        for i in range(n):
            for j in range(i+1,n):
                if arr[j]<arr[i]:
                    arr[i],arr[j]=arr[j],arr[i]
        head=Node(arr[0])
        current=head
        for i in range(1,n):
            current.next=Node(arr[i])
            current=current.next
        return head
    def printlist(self,head):
        while head:
            print(head.data,end=" ")
            head=head.next
obj=Solution()
head=Node(5)
head.next=Node(2)
head.next.next=Node(1)
head=obj.sort(head)
obj.printlist(head)
