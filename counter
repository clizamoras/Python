<!DOCTYPE html>
<html>
<body>

<h2>Character Counter</h2>

<textarea id="text" oninput="count()" placeholder="Type something..."></textarea>

<p id="result">Characters: 0</p>

<script>
function count() {
    let text = document.getElementById("text").value;

    document.getElementById("result").innerHTML =
        "Characters: " + text.length;
}
</script>

</body>
</html>
