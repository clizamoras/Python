class Solution:

    def __init__(self):
        self.queue=[0]*100
        self.r=-1
        self.f=-1
    
    def push(self,x):
        if self.r==-1 and self.f==-1:
            self.r=0
            self.f=0
            self.queue[self.r]=x
        else:
            self.r+=1
            self.queue[self.r]=x
        
    def pop(self):
        x=self.queue[self.f]
        self.f+=1
        return x
    
    def peek(self):
        return self.queue[self.f]
    
    def isEmpty(self):
        return self.f>self.r

    def printqueue(self):
        temp=self.f
        while(temp<=self.r):
            print(self.queue[temp])
            temp+=1

s=Solution()
s.push(10)
s.push(20)
s.push(30)
print("Queue:")
s.printqueue() 
print("Deleted element:")
print(s.pop())
print("Queue after deletion:")
s.printqueue()
print("Peek:")
print(s.peek())
print("Is the queue empty:")
print(s.isEmpty())
