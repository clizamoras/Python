class Node:
    def __init__(self,data):
        self.data=data
        self.next=None
class Solution:
    def loop(self,head):
        temp=head
        li=[]
        while temp:
            if temp.data in li:
                return True
            else :
                li.append(temp.data)
            temp=temp.next
        return False
            
    def printlist(self,head):
        while(head):
            print(head.data,end=" ")
            head=head.next
obj=Solution()
head=Node(1)
first=Node(2)
second=Node(3)
third=Node(4)
fourth=Node(5)
head.next=first
first.next=second
second.next=third
third.next=fourth
fourth.next=second

print(obj.loop(head))
