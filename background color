<!DOCTYPE html>
<html>
<head>
    <title>Change Background</title>
</head>
<body>

    <h2>Change Background Colour</h2>

    <button onclick="changeColor()">Change Color</button>

    <script>
        function changeColor() {
            document.body.style.backgroundColor = "lightpink";
        }
    </script>

</body>
</html>
