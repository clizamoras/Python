class Node:
    def __init__(self,data):
        self.data=data
        self.next=None
class Solution:
    def sort(self,head):
        current=head
        stack=[]
        while current:
            stack.append(current.data)
            current=current.next
        current=head
        while current:
            current.data=stack.pop()
            current=current.next
        current=head
        carry=1
        while current:
            sum=current.data+carry
            current.data=sum%10
            carry=sum//10
            current=current.next
        current=head
        while current:
            stack.append(current.data)
            current=current.next
        current=head
        while current:
            current.data=stack.pop()
            current=current.next
        return head
    def printlist(self,head):
        while head:
            print(head.data,end=" ")
            head=head.next
obj=Solution()

head=Node(1)
first=Node(2)
second=Node(9)
head.next=first
first.next=second
head=obj.sort(head)
obj.printlist(head)