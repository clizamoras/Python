class Solution:
  def __init__(self):
    self.stack=[]
    self.top=-1

  def pop(self):
    x=self.stack[self.top]
    self.stack.pop()
    self.top-=1
    return x

  def isEmpty(self):
    return self.top==-1
    
  def valid(self,s):
    for i in s:
      if i=='(' or i=='[' or i=='{':
        self.stack.append(i)
        self.top+=1

      elif i==')' or i==']' or i=='}':
        if self.isEmpty():
          return False

        elif i==')' and self.stack[self.top]=='(':
          self.pop()

        elif i==']' and self.stack[self.top]=='[':
          self.pop()

        elif i=='}' and self.stack[self.top]=='{':
          self.pop()
        else:
          return False
    if self.isEmpty():
      return True
    else:
      return False
  

obj=Solution()
s=input("Enter the string")
print(obj.valid(s))
