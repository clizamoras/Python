import java.util.Scanner;

public class IPAddressValidator {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter an IP address (format: x.x.x.x): ");
        String ip = sc.nextLine();

        if (isValidIP(ip)) {
            classifyIP(ip);
        } else {
            System.out.println("Invalid IP address! Each number must be between 0 and 255.");
        }
    }

    // Step 1: Validate the IP address
    public static boolean isValidIP(String ip) {
        String[] parts = ip.split("\\.");

        if (parts.length != 4) return false;

        for (String part : parts) {
            try {
                int num = Integer.parseInt(part);
                if (num < 0 || num > 255) return false;
            } catch (NumberFormatException e) {
                return false;
            }
        }
        return true;
    }

    // Step 2: Classify the IP address
    public static void classifyIP(String ip) {
        String[] parts = ip.split("\\.");
        int first = Integer.parseInt(parts[0]);

        if (first >= 1 && first <= 126) {
            if (first == 10) {
                System.out.println("Class A - Private IP");
            } else {
                System.out.println("Class A - Public IP");
            }
        } else if (first == 127) {
            System.out.println("Loopback IP (used for testing)");
        } else if (first >= 128 && first <= 191) {
            if (first == 172 && isPrivateRange(parts, 16, 31)) {
                System.out.println("Class B - Private IP");
            } else {
                System.out.println("Class B - Public IP");
            }
        } else if (first >= 192 && first <= 223) {
            if (ip.startsWith("192.168.")) {
                System.out.println("Class C - Private IP");
            } else {
                System.out.println("Class C - Public IP");
            }
        } else if (first >= 224 && first <= 239) {
            System.out.println("Class D - Multicast IP");
        } else if (first >= 240 && first <= 255) {
            System.out.println("Class E - Reserved for research");
        } else {
            System.out.println("Unknown IP classification.");
        }
    }

    // Helper for Class B private IP
    private static boolean isPrivateRange(String[] parts, int start, int end) {
        int second = Integer.parseInt(parts[1]);
        return second >= start && second <= end;
    }
}