class Solution:
    def binary(self,num,k):
        q=num
        l=[]
        while(q!=0):
            r=q%2
            l.append(r)
            q=int(q/2)
        n=len(l)
        s=""
        for i in range(n-1,-1,-1):
            s=s+str(l[i])
        if s[-(k+1)]=='1':
            return True
        else:
            return False
        
obj=Solution()
num=int(input("Enter the number"))
k=int(input("Enter the position"))
print(obj.binary(num,k))
