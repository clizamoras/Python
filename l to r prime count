class Solution:
    def prime(self,queries):
        ans=[]
        for l,r in queries:
            count=0
            for num in range(l,r+1):
                if num<2:
                    continue
                prime=True
                for i in range(2,num):
                    if num%i==0:
                        prime=False
                        break
                if prime:
                    count=count+1
            ans.append(count)
        return ans
obj=Solution()
queries=[[2,5],[4,7]]
print(obj.prime(queries))
