class Solution:
    def __init__(self):
        self.stack=[0]*100
        self.top=-1
    
    def push(self,x):
        self.top+=1
        self.stack[self.top]=x
    
    def pop(self):
        x=self.stack[self.top]
        self.top-=1
        return x
    
    def peek(self):
        return self.stack[self.top]
    
    def isEmpty(self):
        return self.top==-1
    
    def printstack(self):
        temp=self.top
        while(temp!=-1):
            print(self.stack[temp])
            temp-=1

s=Solution()
s.push(10)
s.push(20)
s.push(30)
print("Stack:")
s.printstack()
print("Deleted element:")
print(s.pop())
print("stack after deletion:")
s.printstack()
print("Topmost element:")
print(s.peek())
print("Is the stack empty:")
print(s.isEmpty())
