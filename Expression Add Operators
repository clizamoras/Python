class Solution:
    def e(self,num,target):
        ans=[]
        def solve(index,expression):
            if index==len(num):
                if eval(expression)==target:
                    ans.append(expression)
                    return
            for j in range(index,len(num)):
                if j>index and num[index]=="0":
                    break
                current=num[index:j+1]
                if index==0:
                    solve(j+1,current)
                else:
                    solve(j+1,expression+"+"+current)
                    solve(j+1,expression+"-"+current)
                    solve(j+1,expression+"*"+current)
        solve(0,"")
        return ans
      


obj = Solution()

num = "123"
target = 6

print(obj.e(num, target))
