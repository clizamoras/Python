class Node:
  def __init__(self,data):
    self.data=data
    self.right=None
    self.left=None
root=Node(1)
root.left=Node(2)
root.right=Node(3)
root.left.left=Node(4)
root.left.right=Node(5)
root.right.left=Node(6)
root.right.right=Node(7)
class Solution:
  def height(self,root):
    if root==None:
      return 0
    return 1+max(self.height(root.left),self.height(root.right))
  def diff(self,root):
    if root==None:
      return True
    p=root
    left=self.height(p.left)
    right=self.height(p.right)
    if abs(left-right)>1:
      return False
    leftheight=self.diff(p.left)
    rightheight=self.diff(p.right)
    if leftheight and rightheight:
      return True
    else:
      return False
obj=Solution()
print(obj.diff(root))
